# ------------------------------------------------------------
# SPA build-time config (Vite reads VITE_* at build, not runtime)
# ------------------------------------------------------------

# Absolute API origin for split deploys (SPA on Vercel + API on Render),
# e.g. https://api.brivia.club — leave EMPTY for same-origin deploys
# (local dev proxy, or Render serving the built SPA itself).
VITE_API_URL=

# Base path of the built site. '/' everywhere except the GitHub Pages
# demo, which builds with /brivia-club/ (see the predeploy script).
VITE_BASE=/
