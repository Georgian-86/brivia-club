# ============================================================
# Brivia API — environment. Copy to .env for local dev.
# FREE STACK: Gmail SMTP for mail, Google + GitHub for OAuth —
# no paid service anywhere. Every feature activates only when
# its vars exist; /api/auth/providers tells the SPA which
# sign-in buttons to render.
# ============================================================

# ---- core ----
PORT=4200
# local docker (docker-compose.yml, pgvector on :5433):
DATABASE_URL=postgresql://brivia:brivia@localhost:5433/brivia
DIRECT_URL=postgresql://brivia:brivia@localhost:5433/brivia
# REQUIRED in production (boot fails closed without it)
JWT_SECRET=change-me

# ---- canonical URLs ----
# Public base of this API — OAuth redirect URIs + email links point here.
API_URL=http://localhost:4200
# Public base of the SPA — OAuth/verification flows land the user here.
CLIENT_URL=http://localhost:5173
# Extra allowed SPA origins for CORS + Socket.IO (comma-separated).
# Prod default is CLIENT_URL; dev is open.
CORS_ORIGINS=

# ---- transactional email (Gmail SMTP — free, ~500 mails/day) ----
# SMTP_USER = the Gmail address. SMTP_PASS = a Gmail App Password
# (Google account → Security → 2-Step Verification ON → App passwords
# → Mail → copy the 16-char code). The normal password will NOT work.
# Leave both unset in dev = every mail prints to server stdout.
SMTP_USER=
SMTP_PASS=
# From header — Gmail rewrites the address to SMTP_USER (or a
# configured "Send mail as" alias); the display name sticks.
EMAIL_FROM=The Brivia Club <you@gmail.com>
# Only set these to use a non-Gmail SMTP relay:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# ---- uploads (Supabase Storage — free tier) ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Google sign-in (console.cloud.google.com → APIs → Credentials, free) ----
# Authorized redirect URI:  {API_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- GitHub sign-in (github.com/settings/developers → OAuth Apps, free) ----
# Authorization callback URL:  {API_URL}/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Apple sign-in: intentionally not supported — it requires the paid
# ($99/yr) Apple Developer Program. If that's ever approved, re-add a
# provider entry in src/routes/oauth.routes.js.
